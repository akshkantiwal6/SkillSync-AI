# ── IBM watsonx.ai credentials ───────────────────────────────────────────────
# Get these from https://cloud.ibm.com/iam/apikeys and your Watson Studio project.
WATSONX_API_KEY=your_ibm_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Model settings (optional) ────────────────────────────────────────────────
# Available Granite models: ibm/granite-13b-instruct-v2  ibm/granite-20b-code-instruct-v1
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Embedding model (optional) ───────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Dataset path (optional — defaults to data/job_resume_fit.csv) ────────────
DATASET_PATH=data/job_resume_fit.csv
